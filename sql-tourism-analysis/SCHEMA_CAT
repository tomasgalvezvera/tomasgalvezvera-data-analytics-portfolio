-- SCHEMA: Centro de Atención Turística (CAT) - GCBA

-- Base de datos para análisis de visitas turísticas
-- Crear tablas en orden: comunas → barrios → cat → paises → visitas

-- =====================================================
-- TABLA: COMUNAS
-- =====================================================
CREATE TABLE comunas (
    id_comuna INT PRIMARY KEY,
    comuna VARCHAR(100) NOT NULL UNIQUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- =====================================================
-- TABLA: BARRIOS
-- =====================================================
CREATE TABLE barrios (
    id_barrio INT PRIMARY KEY,
    barrio VARCHAR(100) NOT NULL,
    id_comuna INT NOT NULL,
    codigo VARCHAR(5),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_comuna) REFERENCES comunas(id_comuna) ON DELETE RESTRICT,
    INDEX idx_id_comuna (id_comuna)
);

-- =====================================================
-- TABLA: CAT (Centros de Atención Turística)
-- =====================================================
CREATE TABLE cat (
    id_cat INT PRIMARY KEY,
    cat VARCHAR(100) NOT NULL UNIQUE,
    id_barrio INT NOT NULL,
    direccion VARCHAR(200),
    telefono VARCHAR(20),
    horario VARCHAR(50),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_barrio) REFERENCES barrios(id_barrio) ON DELETE RESTRICT,
    INDEX idx_id_barrio (id_barrio)
);

-- =====================================================
-- TABLA: PAISES
-- =====================================================
CREATE TABLE paises (
    id_pais INT PRIMARY KEY,
    pais VARCHAR(100) NOT NULL UNIQUE,
    codigo_iso CHAR(2),
    region VARCHAR(50),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- =====================================================
-- TABLA: VISITAS (Tabla Central - Hechos)
-- =====================================================
CREATE TABLE visitas (
    id_visita INT PRIMARY KEY AUTO_INCREMENT,
    id_cat INT NOT NULL,
    id_pais INT NOT NULL,
    id_comuna INT NOT NULL,
    pasajeros INT NOT NULL DEFAULT 0,
    fecha_visita DATETIME,
    consulta_realizada VARCHAR(255),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_cat) REFERENCES cat(id_cat) ON DELETE RESTRICT,
    FOREIGN KEY (id_pais) REFERENCES paises(id_pais) ON DELETE RESTRICT,
    FOREIGN KEY (id_comuna) REFERENCES comunas(id_comuna) ON DELETE RESTRICT,
    INDEX idx_id_cat (id_cat),
    INDEX idx_id_pais (id_pais),
    INDEX idx_id_comuna (id_comuna),
    INDEX idx_fecha_visita (fecha_visita)
);

-- =====================================================
-- ÍNDICES ADICIONALES PARA OPTIMIZACIÓN
-- =====================================================
CREATE INDEX idx_cat_barrio ON cat(id_barrio);
CREATE INDEX idx_visitas_cat_pais ON visitas(id_cat, id_pais);
CREATE INDEX idx_visitas_comuna_pais ON visitas(id_comuna, id_pais);

-- =====================================================
-- VISTAS ÚTILES (OPCIONAL)
-- =====================================================

-- Vista: Resumen por País
CREATE VIEW vw_resumen_paises AS
SELECT 
    p.id_pais,
    p.pais,
    COUNT(v.id_visita) AS cantidad_visitas,
    SUM(v.pasajeros) AS total_pasajeros,
    ROUND(AVG(v.pasajeros), 2) AS promedio_pasajeros,
    MIN(v.pasajeros) AS min_pasajeros,
    MAX(v.pasajeros) AS max_pasajeros
FROM paises p
LEFT JOIN visitas v ON p.id_pais = v.id_pais
GROUP BY p.id_pais, p.pais
ORDER BY cantidad_visitas DESC;

-- Vista: Resumen por CAT
CREATE VIEW vw_resumen_cat AS
SELECT 
    c.id_cat,
    c.cat,
    b.barrio,
    co.comuna,
    COUNT(v.id_visita) AS cantidad_visitas,
    SUM(v.pasajeros) AS total_pasajeros,
    ROUND(AVG(v.pasajeros), 2) AS promedio_pasajeros
FROM cat c
LEFT JOIN barrios b ON c.id_barrio = b.id_barrio
LEFT JOIN comunas co ON b.id_comuna = co.id_comuna
LEFT JOIN visitas v ON c.id_cat = v.id_cat
GROUP BY c.id_cat, c.cat, b.barrio, co.comuna
ORDER BY cantidad_visitas DESC;

-- Vista: Resumen por Comuna
CREATE VIEW vw_resumen_comunas AS
SELECT 
    co.id_comuna,
    co.comuna,
    COUNT(v.id_visita) AS cantidad_visitas,
    SUM(v.pasajeros) AS total_pasajeros,
    ROUND(AVG(v.pasajeros), 2) AS promedio_pasajeros,
    COUNT(DISTINCT c.id_cat) AS cantidad_cat
FROM comunas co
LEFT JOIN visitas v ON co.id_comuna = v.id_comuna
LEFT JOIN cat c ON v.id_cat = c.id_cat
GROUP BY co.id_comuna, co.comuna
ORDER BY cantidad_visitas DESC;

